  <style>
    :root{--bg:#0f1724;--card:#0b1220;--accent:#06b6d4;--muted:#94a3b8}
    html,body{height:100%;margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;background:linear-gradient(180deg,#071022 0%, #0b1220 100%);color:#fff}
    .wrap{max-width:760px;margin:30px auto;padding:20px}
    .card{background:rgba(255,255,255,0.02);padding:22px;border-radius:14px;box-shadow:0 6px 18px rgba(2,6,23,0.6)}
    .hero{display:flex;gap:16px;align-items:center;flex-wrap:wrap}
    .avatar{width:84px;height:84px;border-radius:14px;flex:0 0 84px;overflow:hidden;background:linear-gradient(90deg,var(--accent),#7c3aed)}
